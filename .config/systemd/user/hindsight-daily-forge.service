[Unit]
Description=Daily Hindsight forge for AI artifacts and developer knowledge
After=default.target hindsight-api.service
Wants=hindsight-api.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/bash -lc 'for i in $(seq 1 60); do curl -fsS http://127.0.0.1:8888/health >/dev/null 2>&1 && exit 0; sleep 1; done; echo "hindsight api not reachable on http://127.0.0.1:8888/health" >&2; exit 1'
ExecStart=%h/.hermes/scripts/daily_forge.py --stage full
WorkingDirectory=%h/.hermes
Environment=HERMES_HOME=%h/.hermes
EnvironmentFile=-%h/.hermes/.env
TimeoutStartSec=6h
StandardOutput=append:%h/.hermes/logs/hindsight-daily-forge.log
StandardError=append:%h/.hermes/logs/hindsight-daily-forge.log

[Install]
WantedBy=default.target
