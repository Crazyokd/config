[Unit]
Description=Hindsight Control Plane UI for Hermes unified memory
After=default.target hindsight-api.service
Wants=hindsight-api.service

[Service]
Type=simple
ExecStartPre=/usr/bin/bash -lc 'for i in $(seq 1 60); do curl -fsS http://127.0.0.1:8888/health >/dev/null 2>&1 && exit 0; sleep 1; done; echo "hindsight api not reachable on http://127.0.0.1:8888/health" >&2; exit 1'
ExecStart=%h/.hermes/scripts/start_hindsight_control_plane.sh
Restart=always
RestartSec=5
WorkingDirectory=%h/.hermes
Environment=HERMES_HOME=%h/.hermes
StandardOutput=append:%h/.hermes/logs/hindsight-control-plane.log
StandardError=append:%h/.hermes/logs/hindsight-control-plane.log

[Install]
WantedBy=default.target
