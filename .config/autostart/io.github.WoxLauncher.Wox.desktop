[Desktop Entry]
Type=Application
Name=Wox
Comment=Launch Wox
Exec=/usr/bin/env GDK_BACKEND=x11 /usr/bin/wox
Icon=io.github.WoxLauncher.Wox
Categories=Utility;
MimeType=x-scheme-handler/wox;application/x-wox-plugin;application/x-wox-theme;
Terminal=false
StartupWMClass=wox
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
