#!/bin/sh
set -eu

if ! git diff --cached --name-only --diff-filter=ACMRT | grep -qx 'ai/codex/config.toml'; then
  exit 0
fi

if ! command -v codex >/dev/null 2>&1; then
  echo "pre-commit: codex not found; cannot validate ai/codex/config.toml" >&2
  exit 1
fi

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT HUP INT TERM

git show ':ai/codex/config.toml' >"$tmpdir/config.toml"

output=$(
  CODEX_HOME="$tmpdir" codex --strict-config exec \
    --ignore-rules \
    --skip-git-repo-check \
    --ephemeral \
    --output-schema "$tmpdir/__missing_schema__.json" \
    'validate config' 2>&1
) && {
  echo "pre-commit: unexpected Codex validation success" >&2
  exit 1
}

case "$output" in
  *"Error loading config.toml"*)
    echo "$output" >&2
    exit 1
    ;;
  *"Failed to read output schema file"*)
    echo "pre-commit: ai/codex/config.toml strict validation passed"
    exit 0
    ;;
  *)
    echo "$output" >&2
    exit 1
    ;;
esac
